user www-data;
worker_processes 1;
error_log /dev/stderr warn;
events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_max_body_size 116m;
    absolute_redirect off;

    server {
        listen 8080;
        root /var/www/site;
        index index.php;
        set_real_ip_from 0.0.0.0/0;
        set_real_ip_from ::/0;
        real_ip_header CF-Connecting-IP;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;

        location ~ /\. { return 404; }
        location ~ ^/${FAOXIMA_URL_PATH}/(?:api|panel)/(?:lib|handlers)/ { return 404; }
        location ~ ^/${FAOXIMA_URL_PATH}/(?:index|webhooks)\.php$ {
            try_files $uri =404;
            include /etc/nginx/faoxima-php.conf;
        }
        location ~ ^/${FAOXIMA_URL_PATH}/(?:api|panel|payment|cronbot)/[a-zA-Z0-9_-]+\.php$ {
            try_files $uri =404;
            include /etc/nginx/faoxima-php.conf;
        }
        location ~ "^/${FAOXIMA_URL_PATH}/vpnbot/-?[0-9]{3,20}[a-zA-Z0-9_]{1,64}/index\.php$" {
            try_files $uri =404;
            include /etc/nginx/faoxima-php.conf;
        }
        location ~ ^/${FAOXIMA_URL_PATH}/(?:app|sub)/index\.php$ {
            include /etc/nginx/faoxima-php.conf;
        }
        location ~ ^/${FAOXIMA_URL_PATH}/(?:app|panel)/.*\.(?:css|js|mjs)$ {
            expires -1;
            try_files $uri =404;
        }
        location ~ ^/${FAOXIMA_URL_PATH}/(?:app|panel)/.*\.(?:woff2?|ttf|svg|png|jpe?g|gif|ico|webp)$ {
            expires 30d;
            try_files $uri =404;
        }
        location = /${FAOXIMA_URL_PATH}/app { return 308 /${FAOXIMA_URL_PATH}/app/; }
        location = /${FAOXIMA_URL_PATH}/panel { return 308 /${FAOXIMA_URL_PATH}/panel/; }
        location = /${FAOXIMA_URL_PATH}/panel/ { rewrite ^ /${FAOXIMA_URL_PATH}/panel/index.php last; }
        location = /${FAOXIMA_URL_PATH}/payment/ { rewrite ^ /${FAOXIMA_URL_PATH}/payment/index.php last; }
        location = /${FAOXIMA_URL_PATH}/api/ { rewrite ^ /${FAOXIMA_URL_PATH}/api/index.php last; }
        location /${FAOXIMA_URL_PATH}/app/ { rewrite ^ /${FAOXIMA_URL_PATH}/app/index.php last; }
        location /${FAOXIMA_URL_PATH}/sub/ { rewrite ^ /${FAOXIMA_URL_PATH}/sub/index.php last; }
        location = /${FAOXIMA_URL_PATH}/ { return 308 /${FAOXIMA_URL_PATH}/app/; }
        location / { return 404; }
    }

    server {
        listen 8081;
        location = /health {
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /health;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_read_timeout 2s;
        }
        location = /cron {
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /var/www/faoxima/cron/cron.php;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_read_timeout 85s;
        }
        location / { return 404; }
    }
}
